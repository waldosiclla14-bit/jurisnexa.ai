# JurisNexa.ai - Variables de Entorno
# Copiar a .env.local y completar. Ver src/lib/site.ts (NEXT_PUBLIC_BASE_URL) y src/lib/db/supabase.ts

# ── Dominio canónico ──────────────────────────────────────────────
# Usado por sitemap.ts, robots.ts y layout.tsx (metadataBase). Debe ser
# la URL final en producción sin slash final. Vercel la inyecta como
# NEXT_PUBLIC_BASE_URL; en local dejar https://jurisnexa.ai o http://localhost:3000
NEXT_PUBLIC_BASE_URL=https://jurisnexa.ai

# ── Proveedor LLM (openai | anthropic | google) ───────────────────
LLM_PROVIDER=openai

# OpenAI (recomendado para producción)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic (opcional)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini (opcional - usado también para embeddings)
# GEMINI_API_KEY=your-gemini-key
# NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-3.6-flash

# ── Supabase (RAG vectorial + auth + conversaciones) ──────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Solo necesaria para seed/migraciones y server-side privilegiado
# SUPABASE_SERVICE_KEY=your-service-role-key

# ── Embeddings ────────────────────────────────────────────────────
# Requiere GEMINI_API_KEY. Modelo por defecto: gemini-embedding-001 (3072 dims)
# GEMINI_API_KEY=your-gemini-key

# ── Base de datos (migraciones directas) ──────────────────────────
# Solo para scripts/run-migration.ts con pg. Obtener de Supabase Dashboard > Database
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Corpus local ──────────────────────────────────────────────────
# Directorio base del corpus versionado. Por defecto ./data
# JURISNEXA_LEYES_DATA=./data
